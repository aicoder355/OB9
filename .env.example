# Example environment file for water_delivery_crm
# Copy this to .env and fill values before running locally or with docker

# Django
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me

# Database (if using Postgres in docker-compose)
DATABASE_URL=postgres://postgres:postgres@db:5432/water_delivery

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_MODE=polling
TELEGRAM_ADMIN_CHAT_IDS=

# Email (optional)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Copy this file to `.env` and fill values with your real secrets.
# Do NOT commit the real `.env` file to version control.

# Django
DJANGO_SECRET_KEY=replace-with-a-strong-secret
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Email (optional)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=you@example.com
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=you@example.com

# Telegram bot
TELEGRAM_BOT_TOKEN=replace-with-your-telegram-bot-token
TELEGRAM_MODE=polling  # or 'webhook'

# Admin chat IDs for notifications (comma-separated)
# Get your chat ID by messaging @userinfobot in Telegram
TELEGRAM_ADMIN_CHAT_IDS=

# Driver access code expiry time in hours (default: 24)
DRIVER_CODE_EXPIRY_HOURS=24
